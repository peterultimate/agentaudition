# AgentAudition environment
#
# Copy to .env.local for the web app (Next.js loads it automatically):
#   cp .env.example .env.local
#
# The worker does NOT auto-load dotenv. Either export these in the shell, or run it as
#   node --env-file=.env.local dist/index.js
#
# Local stack: `npm run db:up` starts Postgres and Redis on the ports below.
# Leave DATABASE_URL unset if you only want the web app's fixture catalog (no database).

# ---------------------------------------------------------------------------
# Chain the app registers and reads agents on
# ---------------------------------------------------------------------------
AGENTAUDITION_CHAIN=bsc-testnet
BSC_TESTNET_RPC_URL=https://bsc-testnet-dataseed.bnbchain.org
# Required only when AGENTAUDITION_CHAIN=bsc-mainnet.
# BSC_MAINNET_RPC_URL=https://bsc-dataseed.bnbchain.org

# The ERC-8004 Identity Registry for the chain above. The worker refuses a mismatched
# pairing at boot, because the testnet address also exists on mainnet as an uninitialized
# proxy, where it indexes nothing and reports an empty registry instead of failing.
#   bsc-testnet: 0x8004A818BFB912233c491871b3d84c89A494BD9e
#   bsc-mainnet: 0x8004a169fb4a3325136eb29fa0ceb6d2e539a432
ERC8004_IDENTITY_REGISTRY=0x8004A818BFB912233c491871b3d84c89A494BD9e
ERC8004_REGISTRY_START_BLOCK=0
# ERC8004_VALIDATION_REGISTRY=
# ERC8004_REPUTATION_REGISTRY=

# ---------------------------------------------------------------------------
# Storage. Both are required by the worker's config loader.
# ---------------------------------------------------------------------------
DATABASE_URL=postgresql://agentaudition:agentaudition@localhost:5432/agentaudition
REDIS_URL=redis://localhost:6379

# The chain auditions fork, which is not the chain agents register on. Auditions replay
# market history, so they fork mainnet while identity stays wherever above says.
SHADOW_FORK_CHAIN=bsc-mainnet
# An archive node for SHADOW_FORK_CHAIN. The only variable that turns auditions on;
# indexing and probing run without it.
# BSC_ARCHIVE_RPC_URL=

# ---------------------------------------------------------------------------
# Shadow engine limits
# ---------------------------------------------------------------------------
SHADOW_EGRESS_BUDGET_USD=0.25
SHADOW_EGRESS_ALLOWLIST=api.binance.com,api.coingecko.com,api.pancakeswap.info,api.thegraph.com
SHADOW_MAX_CONCURRENT_FORKS=4
AGENTAUDITION_MAX_DB_MB=380

# Public origin the worker is reachable at, so remote agents can reach the RPC
# interceptor. Point it at a tunnel (ngrok, cloudflared) for local work with real agents.
# AGENTAUDITION_PUBLIC_RPC_BASE_URL=

# ---------------------------------------------------------------------------
# Wallet and payments
# ---------------------------------------------------------------------------
AGENTAUDITION_WALLET_PROVIDER=evm-local
# Signs on BSC mainnet. Never reuse it as the GenLayer key; see below.
# AGENTAUDITION_SIGNER_PRIVATE_KEY=
# ALTANA_API_KEY=

X402_DEFAULT_SCHEME=permit2-upto
X402_SETTLEMENT_TOKEN=USDT
# X402_FACILITATOR_URL=

# ERC-8183 escrow. The client is built and has funded real jobs; it is off by default
# because it moves real $U on every click.
# ERC8183_AGENTIC_COMMERCE=
# ERC8183_EVALUATOR_ROUTER=
# AGENTAUDITION_ESCROW_ENABLED=false

# ---------------------------------------------------------------------------
# GenLayer dispute arbiter. All three of RPC, arbiter address and signer are required
# together; absent, the dispute layer reports itself unavailable rather than falling back
# to an in-process judge, which would be AgentAudition ruling on its own listings.
# ---------------------------------------------------------------------------
# GENLAYER_RPC_URL=https://studio-next.genlayer.com/api
# GENLAYER_ARBITER_ADDRESS=
GENLAYER_CHAIN=studio-next
# GENLAYER_REGISTRAR_ADDRESS=
# Pays gas on a faucet devnet. Deliberately has no fallback to
# AGENTAUDITION_SIGNER_PRIVATE_KEY: a shared key would make the devnet key the mainnet key.
# GENLAYER_SIGNER_PRIVATE_KEY=
# GENLAYER_MARKETPLACE_DOMAIN=

# ---------------------------------------------------------------------------
# Web app and worker operations
# ---------------------------------------------------------------------------
# Signs the hire-ownership cookie. Required in production; without it the key is generated
# per process and every redeploy forgets the cookies it issued.
# AGENTAUDITION_COOKIE_SECRET=

# Lets /status report the worker's queues, which live on a different host from the database.
# AGENTAUDITION_WORKER_HEALTH_URL=
# AGENTAUDITION_WORKER_HEALTH_TOKEN=

# Public origin of the web app, used when building share links.
# AGENTAUDITION_PUBLIC_WEB_URL=http://localhost:3000

# Neon's direct URL, where there is a pooler. The worker migrates on boot.
# DATABASE_URL_UNPOOLED=

# Opt out of migrations running during a deploy build.
# AGENTAUDITION_SKIP_BUILD_MIGRATIONS=

# Optional: enables the 8004scan cross-reference queue.
# ALTLAYER_8004SCAN_API_KEY=

PORT=8080
